# ML models (too large for git). Fetched at build time and checksummed.
# LLM: scripts/fetch_llm_gguf.sh (scripts/llm-gguf.lock) -> Volocal/Resources/LLM
# Speech: scripts/fetch_audio_models.sh (scripts/audio-models.lock) -> Volocal/Resources/Audio
# Do not commit the payloads: GitHub rejects blobs over 100 MB.
/models/
*.gguf
*.ort
*.safetensors
Volocal/Resources/LLM/.*.partial
Volocal/Resources/Audio/**
!Volocal/Resources/Audio/.gitkeep

# Xcode
xcuserdata/
DerivedData/
Volocal.xcodeproj/xcuserdata/
Volocal.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Fastlane
.env
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png.tmp
fastlane/test_output
build/

# Bundler
vendor/bundle
.bundle

# macOS
.DS_Store
